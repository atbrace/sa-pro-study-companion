# AWS Study Companion - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Provider selection: 'claude' (default) or 'gemini'
LLM_PROVIDER=claude

# Claude Configuration (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Override default model (claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini Configuration (required if LLM_PROVIDER=gemini)
# GOOGLE_AI_API_KEY=...
# Optional: Override default model (gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Available Gemini models (as of Jan 2025):
# - gemini-3-flash-preview (default) - Pro-level intelligence at Flash speed/pricing
# - gemini-3-pro-preview - For complex reasoning tasks
# - gemini-2.5-flash - Previous generation
# - gemini-2.5-pro - Previous generation, more capable

# =============================================================================
# AWS Configuration (for CDK labs)
# =============================================================================

# AWS credentials for CDK deployments
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# =============================================================================
# Database Configuration
# =============================================================================

# Optional: Override default database path (./data/study.db)
# DATABASE_PATH=./data/study.db
